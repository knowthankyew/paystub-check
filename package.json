{
  "name": "paystub-check",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "100% local-first legal analyzer for pay stubs, offer letters, FLSA exemption compliance, and state wage-and-hour laws.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:policies": "node scripts/validate-policies.mjs",
    "audit:claims": "node scripts/audit-claims.mjs",
    "record:demo": "bash scripts/record-demo.sh"
  },
  "dependencies": {
    "@knowthankyew/policy-packs": "^1.0.2",
    "@knowthankyew/privacy-telemetry": "^1.0.2",
    "lucide-react": "^1.79.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.2.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "chokidar": "^4.0.3",
    "source-map-js": "^1.2.2"
  }
